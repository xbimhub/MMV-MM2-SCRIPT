local function removeESP(player)
	if espObjects[player] then
		for _, object in ipairs(espObjects[player]) do
			if object and object.Parent then
				object:Destroy()
			end
		end

		espObjects[player] = nil
	end
end

local function createESP(player)
	if player == LocalPlayer and hideOwnESP then
		return
	end

	if not player.Character then
		return
	end

	removeESP(player)

	local highlight = Instance.new("Highlight")

	highlight.Name = "XB1mH4b_ESP"
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = .65
	highlight.OutlineTransparency = .1
	highlight.Adornee = player.Character

	local murderer = findMurderer()
	local sheriff = findSheriff()

	if player == murderer then
		highlight.FillColor = Color3.fromRGB(255, 55, 65)
		highlight.OutlineColor = Color3.fromRGB(255, 55, 65)
	elseif player == sheriff then
		highlight.FillColor = Color3.fromRGB(255, 215, 55)
		highlight.OutlineColor = Color3.fromRGB(255, 215, 55)
	else
		highlight.FillColor = Color3.fromRGB(55, 150, 255)
		highlight.OutlineColor = Color3.fromRGB(55, 150, 255)
	end

	highlight.Parent = gui
	espObjects[player] = {highlight}
end

local function reloadESP()
	for player in pairs(espObjects) do
		removeESP(player)
	end

	if not playerESP then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		createESP(player)
	end
end

