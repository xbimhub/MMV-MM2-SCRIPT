local function unlock()
	if passwordBox.Text == PASSWORD then
		passError.Text = "Access granted."

		tween(
			passwordFrame,
			TweenInfo.new(.25),
			{
				Position = UDim2.fromScale(.5, .47)
			}
		)

		task.wait(.25)

		passwordFrame.Visible = false
		main.Visible = true

		main.Position = UDim2.fromScale(.5, .53)

		tween(
			main,
			TweenInfo.new(
				.3,
				Enum.EasingStyle.Quart
			),
			{
				Position = UDim2.fromScale(.5, .5)
			}
		)
	else
		passError.Text = "Incorrect password."

		tween(
			passwordFrame,
			TweenInfo.new(
				.06,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.InOut,
				3,
				true
			),
			{
				Position = UDim2.fromScale(.505, .5)
			}
		)
	end
end

