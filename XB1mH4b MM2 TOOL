	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	if viewport.X < 650 then
		main.Size = UDim2.new(.9, 0, .75, 0)
	elseif viewport.X < 900 then
		main.Size = UDim2.fromOffset(620, 450)
	else
