local function prepareMurdererShot()
	local sheriff = findSheriff()

	if sheriff ~= LocalPlayer then
		return
	end

	local murderer = findMurderer()

	if not murderer then
		return
	end

	local gun = equipGun()

	if not gun then
		return
	end

	local predictedPosition =
		getPredictedPosition(murderer)

	if not predictedPosition then
		return
	end

	print(
		"[XB1mH4b] Target:",
		murderer.Name,
		"Predicted position:",
		predictedPosition
	)

	-- Le tir doit être effectué par ton système serveur
	-- autorisé. Aucun FireServer de Gun.Shoot n'est exécuté ici.
end

